{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "パックの説明 pack.yaml",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "パックの名前。フォルダ名と同じにする"},
    "version": {"type": ["string", "number"], "description": "パックの版。例: 0.1.0"},
    "description": {"type": "string"},
    "requires": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true,
      "description": "先に読み込む必要がある他のパック"
    }
  }
}
