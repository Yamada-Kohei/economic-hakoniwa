{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "自動で付く名前の材料 naming.yaml の1項目（言語ごと。名前は ja のような言語名）",
  "type": "object",
  "required": ["places", "patterns"],
  "additionalProperties": false,
  "properties": {
    "places": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["label", "first", "second"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1, "description": "作風の表示名（例: イギリス風）"},
          "first": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "description": "地名の前半"},
          "second": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "description": "地名の後半"},
          "joiner": {"type": "string", "description": "前半と後半の間に入れる文字（例: ・）。書かなければ続けて書く"}
        }
      },
      "description": "地名の作風ごとの材料。建国のときに作風を選び、前半と後半を組み合わせて島の地名を作る"
    },
    "numbers": {"type": "array", "items": {"type": "string"}, "description": "1, 2, 3 … の書き方。足りない番号は数字で書く"},
    "duplicate": {"type": "string", "description": "地名で呼ぶ施設が、同じ種類の先の施設と同じ名前になるときの地名の書き方。{place} 地名、{number} 番号（既定「{place}第{number}」）"},
    "industries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "short": {"type": "string", "description": "短い業種名（例: 製鉄）"},
          "long": {"type": "string", "description": "長い業種名（例: 製鉄所）"}
        }
      },
      "description": "施設ごとの業種名。書かなければ施設の表示名を使う"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "description": "条件。体制の軸（politics など）と owner（state / private）"
          },
          "every": {"type": "integer", "minimum": 1, "description": "同じ種類の施設の、この数ごとに1つだけに使う"},
          "text": {"type": "string", "description": "名前の形。{place} 地名、{short} {long} 業種名、{number} 番号、{leader} 国家元首の名前"}
        }
      },
      "description": "上から順に、条件に合う最初の形を使う"
    },
    "override": {"const": true}
  }
}
