+def _average_need(needed: dict[int, dict[str, int]], good: str, turn: int) -> float:
+    """そのターンまでの NEED_TURNS ターンの、島の施設が全力で要る量の平均（1000 分の 1）。"""
+    turns = [t for t in range(turn - NEED_TURNS + 1, turn + 1) if t in needed]
+    return sum(needed[t].get(good, 0) for t in turns) / len(turns) if turns else 0.0
+
+
+def _warehouse_sells(
+    stored: dict[int, dict[str, int]], needed: dict[int, dict[str, int]], good: str, turn: int
+) -> bool:
+    """国の倉庫を、そのターンの品目 good の売り手に数えるか: 倉庫の荷が要る量の平均の
+    WAREHOUSE_TURNS ターン分以上（GT-46 の「国の倉庫の放出」。会議 #4423）。"""
+    held = stored.get(turn, {}).get(good, 0)
+    return held > 0 and held >= WAREHOUSE_TURNS * _average_need(needed, good, turn)
+
