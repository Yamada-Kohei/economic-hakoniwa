# /etc/hakoniwa/hakoniwa.env（root:hakoniwa 0640）。機械の中だけに置き、リポジトリにもチャットにも写さない。
# 値の「<…>」は install.sh の後で、機械の中で作って埋める（docs/ops/build.md）。
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<機械の中で作った 64 字以上のでたらめ>
DJANGO_ALLOWED_HOSTS=hakoniwa.sevilla-lab.com
DATABASE_URL=postgres://hakoniwa:<英数字だけのパスワード>@127.0.0.1:5432/hakoniwa
# Cloudflare の後ろで本当の接続元を読む（PR #151）。Caddy は 127.0.0.1 から gunicorn へ渡す
HAKONIWA_CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
HAKONIWA_TRUSTED_PROXIES=127.0.0.1
# https の cookie など公開用の値は、ゲーム本体の守りを頼んだ別の AI が決めた分をここに足す
